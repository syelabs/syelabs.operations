rules_version = '2';

// SyeLabs Roadmap & Operations Hub - Firestore security rules.
//
// This file is the ONLY thing standing between the public internet and the
// SyeLabs grant ledger, budget, and governance charter. The Firebase config in
// roadmap.html is public by design and protects nothing; these rules run on
// Google's servers and cannot be bypassed by editing the page.
//
// Deploy:  firebase deploy --only firestore:rules
// Or paste into: Firebase console -> Firestore Database -> Rules -> Publish
//
// ---------------------------------------------------------------------------
// TO ADD OR REMOVE A TEAMMATE: edit the list in allowedEmails() below, then
// redeploy. Nothing in roadmap.html needs to change.
// ---------------------------------------------------------------------------

service cloud.firestore {
  match /databases/{database}/documents {

    // The SyeLabs allowlist. Lowercase only - see isTeam() for why.
    function allowedEmails() {
      return [
        'annushapervez7@gmail.com'
         ,'annushapervez127@gmail.com'
        ,'syelabs.thrivetogether@gmail.com'
        ,'fatemakib6@gmail.com'
        ,'syedahabib09@gmail.com'
        ,'israeldavid998@gmail.com'
      ];
    }

    function isTeam() {
      // request.auth is null for signed-out visitors.
      // token.email_verified rejects unverified addresses, which stops someone
      // registering an unverified account claiming a listed address.
      // The email is lowercased because Google returns the address as typed.
      return request.auth != null
             && request.auth.token.email != null
             && request.auth.token.email_verified == true
             && allowedEmails().hasAny([request.auth.token.email.lower()]);
    }

    // The single shared plan document the app reads and writes:
    //   artifacts/{appId}/public_data/plan_{planId}
    match /artifacts/{appId}/public_data/{planDoc} {
      allow read, write: if isTeam();
    }

    // Everything else in the project is denied. Without this a future collection
    // would silently inherit no rule and be unreachable rather than exposed, but
    // stating it makes the intent explicit.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
